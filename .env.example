DATABASE_URL="postgresql://postgres:postgres@localhost:5432/restaurant_saas?schema=public"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
NEXT_PUBLIC_VAPID_PUBLIC_KEY="replace-with-vapid-public-key"
VAPID_PRIVATE_KEY="replace-with-vapid-private-key"
VAPID_SUBJECT="mailto:admin@example.com"
APP_DEBUG_LOGS="false"
TENANT_RESTORE_ENABLED="false"
BACKUP_DIR="./backups"
PLATFORM_RUNTIME_DIR="./runtime"
SERVER_METRICS_FILE="./host-metrics/metrics.json"
MAINTENANCE_WORKER_INTERVAL_MS="30000"
SEPAY_SUBSCRIPTION_WEBHOOK_API_KEY=""

# QAVIO self-registration: no production activation without staging acceptance.
QUANPILOT_TRIAL_REGISTRATION_ENABLED=false
QUANPILOT_QAVIO_TRIAL_SECRET=
QUANPILOT_TRIAL_PUBLIC_ORIGIN=
QUANPILOT_TRIAL_QAVIO_ORIGIN=
QUANPILOT_TRIAL_GOOGLE_CLIENT_ID=
QUANPILOT_TRIAL_GOOGLE_CLIENT_SECRET=
# Set an explicitly approved total trial quota before enabling; no implicit allowance.
QUANPILOT_TRIAL_MAX_TOTAL=
