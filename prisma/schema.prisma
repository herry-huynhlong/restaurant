generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlatformRole {
  PLATFORM_OWNER
  PLATFORM_SUB_ADMIN
  PLATFORM_ADMIN
  USER
}

enum RestaurantRole {
  OWNER
  MANAGER
  CASHIER
  WAITER
  KITCHEN
}

enum RestaurantStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
  DELETED
}

enum RestaurantPlan {
  FREE
  TRAIN
  BASIC
  PRO
}

enum PlanEntitlement {
  BASIC
  PRO
}

enum BusinessType {
  RESTAURANT
  DRINK_SHOP
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  SUSPENDED
}

enum SubscriptionPaymentProvider {
  MOCK
  SEPAY
}

enum SubscriptionPaymentOrderStatus {
  PENDING
  PAID
  EXPIRED
  CANCELLED
  NEEDS_REVIEW
}

enum SubscriptionPaymentTransactionStatus {
  RECEIVED
  MATCHED
  UNMATCHED
  DUPLICATE
  REJECTED
}

enum PaymentWebhookEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  IGNORED
  FAILED
}

enum SubscriptionEntitlementStatus {
  ACTIVE
  CONSUMED
  EXPIRED
  VOID
}

enum SelectionType {
  SINGLE
  MULTI
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  WAITING_FOOD
  PAYMENT_REQUESTED
}

enum DiningSessionStatus {
  OPEN
  AWAITING_PAYMENT
  PAID
  CLOSED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
}

enum OrderStatus {
  NEW
  CONFIRMED
  PREPARING
  READY
  SERVED
}

enum OrderItemStatus {
  NEW
  COOKING
  READY
  SERVED
}

enum PaymentMethod {
  CASH
  QR
  BANK_TRANSFER
  CARD
  OTHER
}

enum ServiceRequestType {
  CALL_STAFF
  REQUEST_WATER
  REQUEST_UTENSILS
  REQUEST_PAYMENT
  OTHER
}

enum ServiceRequestStatus {
  NEW
  ACKNOWLEDGED
  COMPLETED
}

enum NotificationType {
  ORDER_CREATED
  SERVICE_REQUEST_CREATED
  PAYMENT_REQUESTED
  ORDER_READY
  SUBSCRIPTION_EXPIRING
}

model User {
  id                                 String                     @id @default(cuid())
  name                               String
  email                              String                     @unique
  phone                              String?
  passwordHash                       String
  platformRole                       PlatformRole               @default(USER)
  isActive                           Boolean                    @default(true)
  createdAt                          DateTime                   @default(now())
  updatedAt                          DateTime                   @updatedAt
  memberships                        RestaurantUser[]
  confirmedPays                      Payment[]                  @relation("PaymentConfirmedBy")
  auditLogs                          AuditLog[]
  pushSubscriptions                  PushSubscription[]
  subscriptionPaymentOrdersRequested SubscriptionPaymentOrder[] @relation("SubscriptionPaymentOrderRequestedBy")

  @@index([platformRole])
  @@index([isActive])
}

model Restaurant {
  id                              String                           @id @default(cuid())
  name                            String
  slug                            String                           @unique
  logoUrl                         String?
  status                          RestaurantStatus                 @default(ACTIVE)
  plan                            RestaurantPlan                   @default(FREE)
  planEntitlement                 PlanEntitlement                  @default(BASIC)
  businessType                    BusinessType                     @default(RESTAURANT)
  subscriptionStatus              SubscriptionStatus               @default(ACTIVE)
  subscriptionStart               DateTime?
  subscriptionEnd                 DateTime?
  deletedAt                       DateTime?
  deletedByUserId                 String?
  createdAt                       DateTime                         @default(now())
  updatedAt                       DateTime                         @updatedAt
  users                           RestaurantUser[]
  settings                        RestaurantSetting?
  categories                      Category[]
  products                        Product[]
  optionGroups                    ProductOptionGroup[]
  optionItems                     ProductOptionItem[]
  areas                           Area[]
  tables                          RestaurantTable[]
  diningSessions                  DiningSession[]
  orders                          Order[]
  orderItems                      OrderItem[]
  payments                        Payment[]
  serviceRequests                 ServiceRequest[]
  notifications                   Notification[]
  auditLogs                       AuditLog[]
  storageUsage                    RestaurantStorageUsage?
  pushSubscriptions               PushSubscription[]
  backupRuns                      RestaurantBackupRun[]
  restoreRuns                     RestaurantRestoreRun[]
  subscriptionPaymentOrders       SubscriptionPaymentOrder[]
  subscriptionPaymentTransactions SubscriptionPaymentTransaction[]
  paymentWebhookEvents            PaymentWebhookEvent[]
  subscriptionEntitlements        SubscriptionEntitlement[]

  @@index([status])
  @@index([deletedAt])
  @@index([plan])
  @@index([planEntitlement])
  @@index([businessType])
  @@index([createdAt])
}

model PushSubscription {
  id                 String     @id @default(cuid())
  userId             String
  restaurantId       String
  deviceId           String?
  endpoint           String     @unique
  p256dh             String
  auth               String
  userAgent          String?
  deviceName         String?
  onShift            Boolean    @default(true)
  lastShiftStartedAt DateTime?
  lastShiftEndedAt   DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  lastUsedAt         DateTime?
  isActive           Boolean    @default(true)
  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant         Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@index([restaurantId, isActive])
  @@index([restaurantId, userId, deviceId])
  @@index([restaurantId, isActive, onShift])
}

model StaffDeviceSession {
  id              String         @id @default(cuid())
  userId          String
  restaurantId    String
  deviceId        String
  deviceName      String?
  operatorName    String?
  role            RestaurantRole
  onShift         Boolean        @default(true)
  isActive        Boolean        @default(true)
  revokedAt       DateTime?
  revokedByUserId String?
  startedAt       DateTime       @default(now())
  endedAt         DateTime?
  lastSeenAt      DateTime       @default(now())
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([restaurantId, userId, deviceId])
  @@index([restaurantId, onShift])
  @@index([restaurantId, isActive, onShift])
  @@index([userId, onShift])
  @@index([restaurantId, userId, isActive])
}

model RestaurantUser {
  id              String         @id @default(cuid())
  restaurantId    String
  userId          String
  username        String?
  role            RestaurantRole
  isActive        Boolean        @default(true)
  deletedAt       DateTime?
  deletedByUserId String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  restaurant      Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, userId])
  // Active usernames are protected by a partial unique index created in SQL.
  @@index([restaurantId, username])
  @@index([restaurantId, role])
  @@index([userId])
  @@index([isActive])
  @@index([deletedAt])
}

model RestaurantSetting {
  id                       String     @id @default(cuid())
  restaurantId             String     @unique
  restaurantName           String
  logoUrl                  String?
  address                  String?
  phone                    String?
  primaryLanguage          String     @default("vi")
  primaryColor             String     @default("#0f766e")
  currency                 String     @default("VND")
  timezone                 String     @default("Asia/Ho_Chi_Minh")
  bankName                 String?
  bankCode                 String?
  accountNumber            String?
  accountHolder            String?
  paymentTransferContent   String?
  paymentQrImage           String?
  cashEnabled              Boolean    @default(true)
  qrPaymentEnabled         Boolean    @default(true)
  invoiceBusinessName      String?
  invoiceTaxCode           String?
  invoiceAddress           String?
  invoicePhone             String?
  invoiceEmail             String?
  invoiceDisplayName       String?
  taxEnabled               Boolean    @default(false)
  taxRate                  Decimal    @default(0) @db.Decimal(5, 2)
  notificationSoundEnabled Boolean    @default(true)
  notifyNewOrder           Boolean    @default(true)
  notifyServiceRequest     Boolean    @default(true)
  notifyPaymentRequest     Boolean    @default(true)
  createdAt                DateTime   @default(now())
  updatedAt                DateTime   @updatedAt
  restaurant               Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

model Category {
  id           String     @id @default(cuid())
  restaurantId String
  nameVi       String
  nameEn       String?
  sortOrder    Int        @default(0)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  products     Product[]

  @@unique([restaurantId, nameVi])
  @@index([restaurantId, sortOrder])
  @@index([restaurantId, isActive])
}

model Product {
  id            String               @id @default(cuid())
  restaurantId  String
  categoryId    String
  nameVi        String
  nameEn        String?
  descriptionVi String?
  descriptionEn String?
  price         Int
  menuType      String               @default("MAIN")
  imageUrl      String?
  isActive      Boolean              @default(true)
  isSoldOut     Boolean              @default(false)
  isFeatured    Boolean              @default(false)
  sortOrder     Int                  @default(0)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  restaurant    Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category      Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  optionGroups  ProductOptionGroup[]
  orderItems    OrderItem[]

  @@index([restaurantId, categoryId])
  @@index([restaurantId, menuType])
  @@index([restaurantId, isActive])
  @@index([restaurantId, isSoldOut])
  @@index([restaurantId, sortOrder])
}

model ProductOptionGroup {
  id            String              @id @default(cuid())
  restaurantId  String
  productId     String
  nameVi        String
  nameEn        String?
  selectionType SelectionType
  isRequired    Boolean             @default(false)
  minSelect     Int                 @default(0)
  maxSelect     Int                 @default(1)
  sortOrder     Int                 @default(0)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  restaurant    Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  product       Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  items         ProductOptionItem[]

  @@index([restaurantId, productId])
}

model ProductOptionItem {
  id            String             @id @default(cuid())
  restaurantId  String
  optionGroupId String
  nameVi        String
  nameEn        String?
  priceDelta    Int                @default(0)
  isActive      Boolean            @default(true)
  sortOrder     Int                @default(0)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  restaurant    Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  optionGroup   ProductOptionGroup @relation(fields: [optionGroupId], references: [id], onDelete: Cascade)

  @@index([restaurantId, optionGroupId])
  @@index([restaurantId, isActive])
}

model Area {
  id           String            @id @default(cuid())
  restaurantId String
  name         String
  sortOrder    Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  restaurant   Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tables       RestaurantTable[]

  @@index([restaurantId, sortOrder])
}

model RestaurantTable {
  id              String           @id @default(cuid())
  restaurantId    String
  areaId          String
  name            String
  qrToken         String           @unique
  status          TableStatus      @default(AVAILABLE)
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  restaurant      Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  area            Area             @relation(fields: [areaId], references: [id], onDelete: Restrict)
  sessions        DiningSession[]
  orders          Order[]
  serviceRequests ServiceRequest[]
  notifications   Notification[]

  @@unique([restaurantId, name])
  @@index([restaurantId, areaId])
  @@index([restaurantId, status])
  @@index([restaurantId, isActive])
  @@index([qrToken])
}

model DiningSession {
  id              String              @id @default(cuid())
  restaurantId    String
  tableId         String
  status          DiningSessionStatus @default(OPEN)
  openedAt        DateTime            @default(now())
  closedAt        DateTime?
  totalAmount     Int                 @default(0)
  paymentStatus   PaymentStatus       @default(UNPAID)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  restaurant      Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table           RestaurantTable     @relation(fields: [tableId], references: [id], onDelete: Restrict)
  orders          Order[]
  payments        Payment[]
  serviceRequests ServiceRequest[]

  @@index([restaurantId, tableId, status])
  @@index([restaurantId, status])
  @@index([restaurantId, createdAt])
  @@index([tableId, status])
}

model Order {
  id              String          @id @default(cuid())
  restaurantId    String
  diningSessionId String
  tableId         String
  customerName    String
  orderNumber     Int
  status          OrderStatus     @default(NEW)
  subtotal        Int
  idempotencyKey  String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  restaurant      Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  diningSession   DiningSession   @relation(fields: [diningSessionId], references: [id], onDelete: Restrict)
  table           RestaurantTable @relation(fields: [tableId], references: [id], onDelete: Restrict)
  items           OrderItem[]
  notifications   Notification[]

  @@unique([restaurantId, diningSessionId, orderNumber])
  @@unique([restaurantId, idempotencyKey])
  @@index([restaurantId, status])
  @@index([restaurantId, createdAt])
  @@index([diningSessionId, createdAt])
  @@index([restaurantId, tableId])
}

model OrderItem {
  id                             String          @id @default(cuid())
  restaurantId                   String
  orderId                        String
  productId                      String
  productNameViSnapshot          String
  productNameEnSnapshot          String?
  unitPriceSnapshot              Int
  quantity                       Int
  optionSnapshotJson             Json?
  optionTotalSnapshot            Int             @default(0)
  note                           String?
  subtotal                       Int
  status                         OrderItemStatus @default(NEW)
  kitchenAssignedToUserId        String?
  kitchenAssignedDeviceSessionId String?
  kitchenClaimedAt               DateTime?
  readyAt                        DateTime?
  waiterAssignedToUserId         String?
  waiterAssignedDeviceSessionId  String?
  waiterClaimedAt                DateTime?
  servedAt                       DateTime?
  createdAt                      DateTime        @default(now())
  restaurant                     Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  order                          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product                        Product         @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([restaurantId, orderId])
  @@index([restaurantId, productId])
  @@index([restaurantId, status])
  @@index([restaurantId, kitchenAssignedToUserId])
  @@index([restaurantId, kitchenAssignedDeviceSessionId])
  @@index([restaurantId, waiterAssignedToUserId])
  @@index([restaurantId, waiterAssignedDeviceSessionId])
  @@index([restaurantId, readyAt])
}

model Payment {
  id                  String        @id @default(cuid())
  restaurantId        String
  diningSessionId     String
  amount              Int
  invoiceNumber       String?       @unique
  subtotalAmount      Int           @default(0)
  taxRate             Decimal       @default(0) @db.Decimal(5, 2)
  taxAmount           Int           @default(0)
  grandTotal          Int           @default(0)
  tableIdSnapshot     String?
  tableNameSnapshot   String?
  invoiceBusinessName String?
  invoiceTaxCode      String?
  invoiceAddress      String?
  invoicePhone        String?
  invoiceEmail        String?
  invoiceDisplayName  String?
  paymentMethod       PaymentMethod
  status              PaymentStatus @default(PENDING)
  idempotencyKey      String
  paidAt              DateTime?
  confirmedByUserId   String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  restaurant          Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  diningSession       DiningSession @relation(fields: [diningSessionId], references: [id], onDelete: Restrict)
  confirmedBy         User?         @relation("PaymentConfirmedBy", fields: [confirmedByUserId], references: [id], onDelete: SetNull)

  @@unique([restaurantId, idempotencyKey])
  @@index([restaurantId, status])
  @@index([restaurantId, createdAt])
  @@index([diningSessionId])
}

model ServiceRequest {
  id              String               @id @default(cuid())
  restaurantId    String
  diningSessionId String
  tableId         String
  customerName    String
  requestType     ServiceRequestType
  message         String?
  status          ServiceRequestStatus @default(NEW)
  createdAt       DateTime             @default(now())
  resolvedAt      DateTime?
  updatedAt       DateTime             @updatedAt
  restaurant      Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  diningSession   DiningSession        @relation(fields: [diningSessionId], references: [id], onDelete: Restrict)
  table           RestaurantTable      @relation(fields: [tableId], references: [id], onDelete: Restrict)
  notifications   Notification[]

  @@index([restaurantId, status])
  @@index([restaurantId, createdAt])
  @@index([diningSessionId])
}

model Notification {
  id               String           @id @default(cuid())
  restaurantId     String
  recipientUserId  String?
  type             NotificationType
  title            String
  message          String
  tableId          String?
  orderId          String?
  serviceRequestId String?
  isRead           Boolean          @default(false)
  createdAt        DateTime         @default(now())
  restaurant       Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table            RestaurantTable? @relation(fields: [tableId], references: [id], onDelete: Restrict)
  order            Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  serviceRequest   ServiceRequest?  @relation(fields: [serviceRequestId], references: [id], onDelete: SetNull)

  @@index([restaurantId, isRead])
  @@index([restaurantId, createdAt])
  @@index([restaurantId, type])
  @@index([recipientUserId, isRead])
}

model AuditLog {
  id           String      @id @default(cuid())
  restaurantId String?
  userId       String?
  action       String
  entityType   String
  entityId     String?
  metadataJson Json?
  createdAt    DateTime    @default(now())
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user         User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([restaurantId, createdAt])
  @@index([userId])
  @@index([action])
}

model PlatformDataPolicy {
  id                         String    @id @default(cuid())
  singletonKey               String    @unique @default("default")
  backupEnabled              Boolean   @default(true)
  backupTime                 String    @default("02:00")
  backupRetentionCount       Int       @default(3)
  notificationRetentionDays  Int       @default(3)
  temporaryDataRetentionDays Int       @default(60)
  backupStorageKind          String    @default("LOCAL")
  lastCleanupAt              DateTime?
  nextCleanupAt              DateTime?
  lastTaskStatus             String?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
}

model PlatformSubscriptionPolicy {
  id                   String   @id @default(cuid())
  singletonKey         String   @unique @default("default")
  trialEnabled         Boolean  @default(true)
  trialDays            Int      @default(60)
  trialRestaurantLimit Int      @default(20)
  gracePeriodDays      Int      @default(3)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model PlatformBackupRun {
  id                 String    @id @default(cuid())
  status             String    @default("QUEUED")
  triggerType        String    @default("MANUAL")
  storageKind        String    @default("LOCAL")
  locationLabel      String?
  databaseDumpName   String?
  uploadsArchiveName String?
  sizeBytes          BigInt    @default(0)
  checksum           String?
  verifiedAt         DateTime?
  errorMessage       String?
  queuedAt           DateTime  @default(now())
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([status, queuedAt])
  @@index([createdAt])
}

model RestaurantBackupRun {
  id                     String                 @id @default(cuid())
  restaurantId           String
  restaurantNameSnapshot String
  status                 String                 @default("QUEUED")
  triggerType            String                 @default("MANUAL")
  backupDate             String?
  snapshotName           String?
  uploadsArchiveName     String?
  sizeBytes              BigInt                 @default(0)
  checksum               String?
  schemaVersion          Int                    @default(1)
  verifiedAt             DateTime?
  errorMessage           String?
  queuedAt               DateTime               @default(now())
  startedAt              DateTime?
  completedAt            DateTime?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  restaurant             Restaurant             @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restoreRuns            RestaurantRestoreRun[]

  @@unique([restaurantId, triggerType, backupDate])
  @@index([restaurantId, status, queuedAt])
  @@index([status, queuedAt])
  @@index([createdAt])
}

model RestaurantRestoreRun {
  id            String              @id @default(cuid())
  restaurantId  String
  backupRunId   String
  actorUserId   String
  status        String              @default("QUEUED")
  publicMessage String?
  rollbackReady Boolean             @default(false)
  errorMessage  String?
  queuedAt      DateTime            @default(now())
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  restaurant    Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  backupRun     RestaurantBackupRun @relation(fields: [backupRunId], references: [id], onDelete: Restrict)

  @@index([restaurantId, status, queuedAt])
  @@index([status, queuedAt])
  @@index([backupRunId])
}

model PlatformMaintenanceRun {
  id                    String    @id @default(cuid())
  taskType              String
  status                String    @default("QUEUED")
  deletedNotifications  Int       @default(0)
  deletedDeviceSessions Int       @default(0)
  errorMessage          String?
  queuedAt              DateTime  @default(now())
  startedAt             DateTime?
  completedAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([taskType, status, queuedAt])
  @@index([createdAt])
}

model PlatformWorkerHeartbeat {
  id           String   @id @default(cuid())
  singletonKey String   @unique
  serviceName  String
  status       String   @default("OK")
  message      String?
  lastSeenAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([serviceName, lastSeenAt])
}

model RestaurantStorageUsage {
  id             String     @id @default(cuid())
  restaurantId   String     @unique
  estimatedBytes BigInt     @default(0)
  dataBytes      BigInt     @default(0)
  uploadBytes    BigInt     @default(0)
  calculatedAt   DateTime   @default(now())
  note           String?
  restaurant     Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([estimatedBytes])
  @@index([calculatedAt])
}

model PlatformPlanPrice {
  id              String         @id @default(cuid())
  plan            RestaurantPlan
  termMonths      Int
  priceVnd        Int
  monthlyPriceVnd Int
  isActive        Boolean        @default(true)
  isRecommended   Boolean        @default(false)
  description     String?
  sortOrder       Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([plan, termMonths])
  @@index([plan, isActive])
  @@index([sortOrder])
}

model PlatformPlanPriceHistory {
  id               String   @id @default(cuid())
  priceId          String?
  plan             String
  termMonths       Int
  oldPriceVnd      Int?
  newPriceVnd      Int
  oldIsActive      Boolean?
  newIsActive      Boolean
  oldIsRecommended Boolean?
  newIsRecommended Boolean
  oldDescription   String?
  newDescription   String?
  actorUserId      String?
  createdAt        DateTime @default(now())

  @@index([plan, termMonths])
  @@index([createdAt])
}

model RestaurantSubscriptionRequest {
  id                       String                     @id @default(cuid())
  restaurantId             String
  requestedByUserId        String
  requestType              String                     @default("RENEWAL")
  currentPlan              String?
  plan                     RestaurantPlan
  termMonths               Int
  priceVnd                 Int
  monthlyPriceVnd          Int
  status                   String                     @default("PENDING")
  note                     String?
  adminNote                String?
  confirmedByUserId        String?
  confirmedAt              DateTime?
  rejectedByUserId         String?
  rejectedAt               DateTime?
  activatedStart           DateTime?
  activatedEnd             DateTime?
  currentSubscriptionStart DateTime?
  currentSubscriptionEnd   DateTime?
  quoteExpiresAt           DateTime?
  pricingSnapshotJson      Json?
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  paymentOrders            SubscriptionPaymentOrder[]
  entitlements             SubscriptionEntitlement[]

  @@index([restaurantId, status])
  @@index([status, createdAt])
  @@index([requestType, status])
  @@index([requestedByUserId])
}

model SubscriptionPaymentOrder {
  id                      String                           @id @default(cuid())
  restaurantId            String
  subscriptionRequestId   String
  requestedByUserId       String
  provider                SubscriptionPaymentProvider      @default(MOCK)
  status                  SubscriptionPaymentOrderStatus   @default(PENDING)
  idempotencyKey          String
  transferCode            String                           @unique
  requestType             String
  plan                    RestaurantPlan
  termMonths              Int
  amountVnd               Int
  currency                String                           @default("VND")
  priceSnapshotJson       Json
  entitlementSnapshotJson Json?
  expiresAt               DateTime
  paidAt                  DateTime?
  cancelledAt             DateTime?
  createdAt               DateTime                         @default(now())
  updatedAt               DateTime                         @updatedAt
  restaurant              Restaurant                       @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  subscriptionRequest     RestaurantSubscriptionRequest    @relation(fields: [subscriptionRequestId], references: [id], onDelete: Restrict)
  requestedBy             User                             @relation("SubscriptionPaymentOrderRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  transactions            SubscriptionPaymentTransaction[]
  webhookEvents           PaymentWebhookEvent[]
  entitlement             SubscriptionEntitlement?

  @@unique([restaurantId, idempotencyKey])
  @@unique([subscriptionRequestId, idempotencyKey])
  @@index([restaurantId, status, createdAt])
  @@index([status, expiresAt])
  @@index([requestedByUserId, createdAt])
}

model SubscriptionPaymentTransaction {
  id                    String                               @id @default(cuid())
  restaurantId          String
  paymentOrderId        String?
  provider              SubscriptionPaymentProvider
  providerTransactionId String
  status                SubscriptionPaymentTransactionStatus @default(RECEIVED)
  amountVnd             Int
  currency              String                               @default("VND")
  transferContent       String?
  receivedAt            DateTime                             @default(now())
  providerOccurredAt    DateTime?
  payloadJson           Json?
  createdAt             DateTime                             @default(now())
  updatedAt             DateTime                             @updatedAt
  restaurant            Restaurant                           @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  paymentOrder          SubscriptionPaymentOrder?            @relation(fields: [paymentOrderId], references: [id], onDelete: SetNull)
  webhookEvents         PaymentWebhookEvent[]

  @@unique([provider, providerTransactionId])
  @@index([restaurantId, status, receivedAt])
  @@index([paymentOrderId, createdAt])
}

model PaymentWebhookEvent {
  id                   String                          @id @default(cuid())
  restaurantId         String
  paymentOrderId       String?
  paymentTransactionId String?
  provider             SubscriptionPaymentProvider
  providerEventId      String
  status               PaymentWebhookEventStatus       @default(RECEIVED)
  payloadHash          String
  payloadJson          Json?
  attemptCount         Int                             @default(0)
  receivedAt           DateTime                        @default(now())
  processedAt          DateTime?
  lastError            String?
  createdAt            DateTime                        @default(now())
  updatedAt            DateTime                        @updatedAt
  restaurant           Restaurant                      @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  paymentOrder         SubscriptionPaymentOrder?       @relation(fields: [paymentOrderId], references: [id], onDelete: SetNull)
  paymentTransaction   SubscriptionPaymentTransaction? @relation(fields: [paymentTransactionId], references: [id], onDelete: SetNull)

  @@unique([provider, providerEventId])
  @@index([restaurantId, status, receivedAt])
  @@index([status, createdAt])
  @@index([paymentOrderId])
  @@index([paymentTransactionId])
}

model SubscriptionEntitlement {
  id                    String                         @id @default(cuid())
  restaurantId          String
  subscriptionRequestId String?
  paymentOrderId        String?                        @unique
  status                SubscriptionEntitlementStatus  @default(ACTIVE)
  plan                  RestaurantPlan
  termMonths            Int
  amountVnd             Int
  currency              String                         @default("VND")
  startsAt              DateTime
  endsAt                DateTime
  priceSnapshotJson     Json
  createdAt             DateTime                       @default(now())
  updatedAt             DateTime                       @updatedAt
  restaurant            Restaurant                     @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  subscriptionRequest   RestaurantSubscriptionRequest? @relation(fields: [subscriptionRequestId], references: [id], onDelete: SetNull)
  paymentOrder          SubscriptionPaymentOrder?      @relation(fields: [paymentOrderId], references: [id], onDelete: Restrict)

  @@index([restaurantId, status, endsAt])
  @@index([restaurantId, plan, startsAt])
  @@index([subscriptionRequestId])
}

model RestaurantSubscriptionEvent {
  id           String    @id @default(cuid())
  restaurantId String
  requestId    String?
  actorUserId  String?
  action       String
  plan         String?
  termMonths   Int?
  priceVnd     Int?
  startAt      DateTime?
  endAt        DateTime?
  metadataJson Json?
  createdAt    DateTime  @default(now())

  @@index([restaurantId, createdAt])
  @@index([requestId])
  @@index([action])
}
